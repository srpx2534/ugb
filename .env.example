# ============================================================================
# URETIM yapilandirmasi. Yerelde kullanma, orada ugb/.env var.
# Bu dosya deploy/app-kur.sh tarafindan yazilir; elle duzenlersen chmod 600 koru.
# ============================================================================

# --- Ortam ------------------------------------------------------------------
# prod: uretim kurallari devreye girer (zorunlu PORT, https zorlamasi, siki sema).
# "production" degil, "prod" yazilir.
NODE_ENV=prod

# Hangi dikey yayinlanacak: bonus | canli-mac
DIKEY=canli-mac

# Skin/decoy secimi icin site kimligi. Tek site kurulumunda 1 kalir.
SITE_ID=1

# --- Veritabani -------------------------------------------------------------
# Uzak DB kullaniyorsan host'u degistir; ayni makinedeyse 127.0.0.1 kalir.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ugb

# Uygulama kullanicisi: root DEGIL. Yalniz bu semaya yetkili olmali.
DB_USER=ugb_app
# En az 16 karakter. Uret: openssl rand -base64 24
DB_PASS=DEGISTIR-EN-AZ-16-KARAKTER

# Havuzdaki es zamanli baglanti tavani. Uc uygulama ayni kullaniciyi paylasir,
# toplam 30 baglanti eder; MySQL max_connections bunun uzerinde olmali.
DB_POOL=10

# Havuz doldugunda bekleme kuyrugunun tavani. Asilinca 503 + Retry-After doner.
DB_QUEUE_LIMIT=40
# Baglanti kurma zaman asimi (ms).
DB_BAGLANTI_ZAMAN_ASIMI_MS=3000
# Tek sorgu zaman asimi (ms). Uzun SELECT'lerde baglanti kilitlenmesin.
DB_SORGU_ZAMAN_ASIMI_MS=3000
# Transaction toplam zaman asimi (ms).
DB_ISLEM_ZAMAN_ASIMI_MS=8000
# 503 yanitinda istemciye "kac saniye sonra dene" denecek.
DB_RETRY_AFTER_SN=2

# --- Public adres -----------------------------------------------------------
# ZORUNLU ve PORTSUZ olmali. Ic port yazarsan acilis durur.
# Semayi https yap; http kalirsa Basic Auth sifresi acikta gider.
HUB_URL=https://hedefb.com
# Yonetim ve canonical icin kok host. www/m. yazma.
HUB_HOST=hedefb.com

# --- Sirlar -----------------------------------------------------------------
# Yonetici paneli parolasi: en az 12 karakter. Uret: openssl rand -base64 18
ADMIN_PAROLA=DEGISTIR-EN-AZ-12-KARAKTER
# IP ve tiklama hash tuzu: en az 16 karakter. Uret: openssl rand -hex 32
# Degistirirsen eski clicks.ip_hash degerleriyle korelasyon kopar.
HASH_TUZU=DEGISTIR-32-KARAKTER-RASGELE

# --- Proxy ve guvenlik ------------------------------------------------------
# nginx arkasindayiz: gercek istemci IP'si X-Forwarded-For'dan okunur.
# KAPATMA. Kapaliysa butun trafik 127.0.0.1 gorunur, bot tespiti ve IP
# kisitlamasi bozulur.
TRUST_PROXY=true

# Cloudflare onekde ise 1 yap; istemci IP'si CF-Connecting-IP'den alinir.
CF_ARKADA=0

# Uygulamalarin dinledigi adres. nginx ayni makinede oldugu icin 127.0.0.1.
# Konteyner ya da uzak proxy arkasinda 0.0.0.0 yap.
DINLEME_HOST=127.0.0.1

# Yonetim paneli yalniz https uzerinden acilsin. Sertifika YOKKEN 0 birak,
# yoksa /admin sonsuz yonlendirmeye girer.
HUB_HTTPS_ZORLA=1

# Yonetim paneli IP izin listesi (virgulle ayrilmis IPv4). Bos = herkese acik.
# Sabit IP'n yoksa bos birak; doldurursan kendi IP'ni eklemeyi unutma.
HUB_IZINLI_IP=


# /api kimlik dogrulamasi. 0 = herkese acik.
HUB_API_KORU=1

# --- Davranis ---------------------------------------------------------------
# Bot tespitini atla, her istegi bot say (test icin). Uretimde 0.
BOT_ZORLA=0
# UA tutarsizligini bot say. Gevsek mod: 1 kalabilir.
BOT_UA_GECER=1
# Host onbellegi tazeleme araligi (ms). 60000 altina inme.
HOSTMAP_TTL_MS=60000

# --- Log --------------------------------------------------------------------
# info | warn | error. Uretimde warn gurultuyu azaltir ama acilis satiri da gider.
LOG_SEVIYE=info

# --- Erisim kaydi -----------------------------------------------------------
# 0 = kapali, 1 = acik. Kapatirsan SEO/bot analizi korlesir.
CRAWL_LOG=1
# Ornekleme: 1 = hepsi, 10 = her 10 istekten 1'i. Bot, 4xx/5xx ve /l/ her zaman yazilir.
CRAWL_LOG_ORNEK=10
# Tek INSERT'te yazilan satir sayisi.
CRAWL_LOG_TOPLU=200
# Bosaltma araligi (ms).
CRAWL_LOG_ARALIK_MS=1000
# Bellekte tutulacak azami kayit. Asilirsa en eski dusurulur.
CRAWL_LOG_KUYRUK=3000
# Saklama suresi (gun). Saatte bir parca parca silinir.
CRAWL_LOG_SAKLAMA_GUN=14

# --- Ic portlar -------------------------------------------------------------
# PORT YAZILMAZ: bu ucu ecosystem.cjs tarafindan PORT olarak gecirilir.
# Disariya kapali, yalniz 127.0.0.1 icin. nginx.conf.tpl ayni degerleri kullanir.
CARRIER_PORT=3001
HUB_PORT=3002
SPOKE_PORT=3003
